{
  "rules": {
    "preset-zh-technical-writing": {
      // 中文排版规范：中西文间空格、数字与中文间空格、
      // 全角英文、不成对引号、空段落、重复连接词等。
      // 关闭对英文内容过于严格的规则（仓库含中英混排）。
      "no-empty-section": true,
      "space-round-alphabet": true,
      "space-round-number": true,
      "no-fullwidth-alphabet": true,
      "no-unmatched-pair": true,
      "no-doubled-conjunctive-particle-ga": false
    }
  }
}
